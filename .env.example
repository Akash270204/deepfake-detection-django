# Copy this to .env and fill in your values before deploying
# docker-compose automatically reads .env from the same directory

# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=your-strong-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated. Add your EC2 public IP or domain (no spaces)
# Example: ALLOWED_HOSTS=54.123.45.67,myapp.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
